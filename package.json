{
  "name": "ajudan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:migrate && concurrently -k -n web,worker -c blue,magenta \"next dev\" \"pnpm worker\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "web": "next dev",
    "worker": "tsx watch --clear-screen=false worker/index.ts",
    "worker:once": "tsx worker/index.ts --once",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.304",
    "@playwright/mcp": "0.0.83",
    "@shadcn/react": "^0.3.1",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.60.0",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "streamdown": "2.7.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.10.0",
  "type": "module"
}
